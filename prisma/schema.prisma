// **NOTE: dont remove updatedAt in any tables **
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityEvent {
  id        String   @id @default(cuid())
  email     String
  eventType String
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
